# Yashome settings and secrets. You normally do not edit this file:
# `make install` copies it to .env and fills every value in (tokens and passwords are
# generated, the time zone is taken from the host; each plug-in adds and fills its own
# keys from its setup/env.example). Change .env afterwards
# and run `make update`. .env is git-ignored; never commit it.

# User and group the backend runs as, so the files it writes next to the checkout belong to you.
# make install: your id -u / id -g.
PUID=
PGID=

# Compose profiles, comma separated. A plug-in may switch its own on or off (zigbee follows
# Z2M_SERIAL); yours stay. COMPOSE_FILE is written by make update: the core's file plus every
# plug-in's setup/compose.yml - do not edit it.
COMPOSE_PROFILES=

# Plug-ins to load, comma separated (the directory names in plugins/, e.g. zigbee,weather; * = all).
# make install adds zigbee when it finds a coordinator stick. Settings -> Plug-ins lists the others.
PLUGINS=
# A directory of plug-ins of your own beside the shipped ones, mounted read-only. Empty = ./plugins-extra.
PLUGINS_EXTRA_DIR=
# Python packages those plug-ins need, pinned and space separated (e.g. cryptography==50.0.1);
# baked into the backend image by `make update`.
EXTRA_PIP=

# Host port of the dashboard (http://<host>:PORT). Change if 8765 is taken.
DASHBOARD_PORT=8765

# Host port of the MQTT broker. Only the host side changes: inside the compose network
# the broker is always mosquitto:1883.
MQTT_PORT=1883

# Bearer token that protects /api and /ws of the dashboard. With an empty value the
# backend refuses every request (fail closed). make install: `openssl rand -hex 24`, printed once at the end.
DASHBOARD_TOKEN=

# Public address(es) of the dashboard behind a reverse proxy that rewrites Host, comma
# separated, e.g. https://home.example.org,https://home.local:8765. Without it such a proxy gets 403 on every change.
DASHBOARD_ORIGINS=

# MQTT account the backend uses. make install: `openssl rand -base64 18`; `make secrets`
# writes it into config/mosquitto/dynamic-security.json, it is never shown.
MQTT_HOST=mosquitto
MQTT_USER=home
MQTT_PASSWORD=

# Optional accounts for your devices (comma separated), each with MQTT_<NAME>_PASSWORD, e.g.
# MQTT_DEVICE_USERS=esp and MQTT_ESP_PASSWORD=... They may do everything except publish to home/state/#,
# to what a plug-in marks read-only for devices (zigbee2mqtt/#) and to the topic filters in MQTT_BACKEND_ONLY (space or comma separated; a plug-in's docs name the ones it needs).
MQTT_DEVICE_USERS=
MQTT_BACKEND_ONLY=

# Time zone for schedules (IANA name). make install takes it from the host.
TZ=
