# Yashome settings and secrets. You normally do not edit this file:
# `make install` copies it to .env and fills every value in (tokens and passwords are
# generated, the coordinator stick is found in /dev/serial/by-id, the time zone is
# taken from the host). Change .env afterwards
# and run `make update`. .env is git-ignored; never commit it.

# User and group the backend runs as, so the files it writes next to the checkout belong to you.
# make install: your id -u / id -g.
PUID=
PGID=

# Compose profiles: "zigbee" starts zigbee2mqtt. make install / make update keep it in step with
# Z2M_SERIAL below; add your own profiles here, comma separated.
COMPOSE_PROFILES=

# Directory with plug-ins (one package per sub-directory, docs/plugins.md), mounted read-only
# into the backend. Empty = ./plugins next to this file (git-ignored).
PLUGINS_DIR=

# Host port of the dashboard (http://<host>:PORT). Change if 8765 is taken.
DASHBOARD_PORT=8765

# Host ports of the MQTT broker and the zigbee2mqtt frontend. Only the host side
# changes: inside the compose network the broker is always mosquitto:1883.
MQTT_PORT=1883
Z2M_PORT=8080

# Bearer token that protects /api and /ws of the dashboard. With an empty value the
# backend refuses every request (fail closed). make install: `openssl rand -hex 24`, printed once at the end.
DASHBOARD_TOKEN=

# Public address(es) of the dashboard behind a reverse proxy that rewrites Host, comma
# separated, e.g. https://home.example.org,https://home.local:8765. Without it such a proxy gets 403 on every change.
DASHBOARD_ORIGINS=

# MQTT account the backend uses. make install: `openssl rand -base64 18`; `make secrets`
# writes it into config/mosquitto/passwd, it is never shown.
MQTT_HOST=mosquitto
MQTT_USER=home
MQTT_PASSWORD=

# MQTT account for zigbee2mqtt. Generated the same way; `make secrets` writes it into
# config/mosquitto/passwd and config/zigbee2mqtt/secret.yaml.
MQTT_Z2M_USER=z2m
MQTT_Z2M_PASSWORD=

# Login of the zigbee2mqtt web frontend (:8080). Generated; you type it once in the browser.
Z2M_AUTH_TOKEN=

# Zigbee coordinator stick. make install takes the single entry of /dev/serial/by-id/ or asks.
# Use the full by-id path, not /dev/ttyUSB0 (that name moves when another adapter is plugged in).
# Empty or none = the stack starts without zigbee2mqtt. external = zigbee2mqtt runs elsewhere
# on the same broker: no container here, but the backend expects its devices.
Z2M_SERIAL=

# Time zone for schedules (IANA name). make install takes it from the host.
TZ=
