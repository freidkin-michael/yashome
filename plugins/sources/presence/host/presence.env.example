# /etc/yashome/presence.env (chmod 600): the presence host piece.
PRESENCE_MACS=00:11:22:33:44:55
PRESENCE_IFACE=
# optional: away after this many seconds unseen (600), a probe every N s (30), a full sweep at most
# every N s (300); PRESENCE_STATE_DIR only when run without the shipped unit (it sets its own)
# PRESENCE_GRACE=600
# PRESENCE_INTERVAL=30
# PRESENCE_SWEEP_GAP=300
# PRESENCE_STATE_DIR=/var/lib/phone-presence
MQTT_HOST=192.0.2.10
MQTT_PORT=1883
MQTT_PRESENCE_USER=presence
MQTT_PRESENCE_PASSWORD=
