# NTAG 424 DNA SDM keys (32 hex chars each). Keep them secret. A tap of a tag on the list (Settings -> Devices -> NFC tags)
# is the event "card = <name>" of the device nfc - a rule decides what it does. Needs EXTRA_PIP=cryptography==50.0.1
NFC_SDM_META_KEY=
NFC_SDM_FILE_KEY=
# The master key (key 0) of the cards the house writes itself (the Yash! app: menu -> Write a card), 32 hex chars.
# Keep it secret and keep a copy: a card written with it can be rewritten only with it. Without it the house writes no cards.
NFC_MASTER_KEY=
