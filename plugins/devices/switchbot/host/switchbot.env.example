# /etc/yashome/switchbot-<id>.env (chmod 600): one lock, the bridge instance switchbot-lock@<id>.
SWITCHBOT_LOCK_ID=front_lock
SWITCHBOT_LOCK_MODEL=lock_ultra
SWITCHBOT_LOCK_MAC=AA:BB:CC:DD:EE:FF
SWITCHBOT_LOCK_KEY_ID=
SWITCHBOT_LOCK_ENC_KEY=
MQTT_HOST=192.0.2.10
MQTT_PORT=1883
MQTT_SWITCHBOT_USER=switchbot
MQTT_SWITCHBOT_PASSWORD=
