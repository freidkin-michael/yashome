# The Home Panel launcher's package; empty = org.yashome.panel. A house whose tablets run an older launcher
# keeps that one's package here, so Build the app installs as an update (signed with the same key).
PANELS_APP_ID=
# Launcher packages whose tablets move to PANELS_APP_ID (comma list; a renamed launcher): once the house's package
# is installed on such a tablet, the old launcher hands it over. One way: never from PANELS_APP_ID back.
PANELS_MIGRATE_FROM=
# ESP panels (they join the house Wi-Fi, HOUSE_WIFI_*, and reach the broker at BIND_ADDRESS; their texts are in the house
# language): their broker account, the password of updates over Wi-Fi and of their own setup Wi-Fi ("<name>-setup").
# Made by make install / make update.
MQTT_PANELS_USER=
MQTT_PANELS_PASSWORD=
PANELS_OTA_PASSWORD=
PANELS_AP_PASSWORD=
