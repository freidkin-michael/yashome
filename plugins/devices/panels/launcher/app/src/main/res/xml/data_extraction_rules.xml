<?xml version="1.0" encoding="utf-8"?>
<!-- The panel's key (shared preferences) never leaves the tablet: no cloud backup, no device transfer -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
