# Zigbee coordinator: a stick's /dev/serial/by-id/ path or a network one as tcp://host:port (SLZB,
# ZigStar); make install takes the single one it finds (USB or mDNS) or asks. Empty or none = no
# zigbee2mqtt; external = it runs elsewhere on this broker (no container here). In Settings: tcp:// or
# none only, a stick is set on the host. [network-ok]
Z2M_SERIAL=
# Set by make update from Z2M_SERIAL: the device passed into the container (/dev/null for tcp://). [host-only]
Z2M_DEVICE=
# zigbee2mqtt adapter: ember (Silicon Labs EFR32) or zstack (TI CC2652); empty keeps the one in
# configuration.yaml. [one of: ember zstack deconz zigate ezsp]
Z2M_ADAPTER=
# zigbee2mqtt's frontend login and MQTT account (generated): the dashboard fills the login in itself.
Z2M_AUTH_TOKEN=
MQTT_Z2M_USER=z2m
MQTT_Z2M_PASSWORD=
# Where zigbee2mqtt keeps its network (configuration.yaml, database.db). Empty: make update picks
# ./config/zigbee2mqtt when a zigbee2mqtt network is there already, else ./plugin-data/zigbee/zigbee2mqtt.
Z2M_DATA_DIR=
