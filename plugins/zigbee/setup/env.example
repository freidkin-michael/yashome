# Zigbee coordinator stick: make install takes the single /dev/serial/by-id/ entry or asks. Empty or
# none = no zigbee2mqtt; external = it runs elsewhere on this broker (no container here).
Z2M_SERIAL=
# Host port of the zigbee2mqtt frontend and its login (generated), and zigbee2mqtt's MQTT account.
Z2M_PORT=8080
# zigbee2mqtt adapter for a new configuration.yaml: ember (Silicon Labs: Sonoff ZBDongle-E, SLZB-06M) or zstack (TI)
Z2M_ADAPTER=
Z2M_AUTH_TOKEN=
MQTT_Z2M_USER=z2m
MQTT_Z2M_PASSWORD=
# Where zigbee2mqtt keeps its network (configuration.yaml, database.db). Empty: make update picks
# ./config/zigbee2mqtt when a zigbee2mqtt network is there already, else ./plugin-data/zigbee/zigbee2mqtt.
Z2M_DATA_DIR=
