# The user the house logs in to its computers as (with its key, YASHOME_SSH_DIR/id); sudo must ask that user no password.
COMPUTERS_SSH_USER=
# The big model's tunnel (:11435) and health (:11436) on more addresses than 127.0.0.1 (host/install.sh): IPv4, comma
# separated, e.g. the gateway of a Docker bridge whose containers use it (a host firewall must let that bridge in).
LLM_LISTEN=
# yashGen moved to another computer (role yashgen; host/install.sh): the builder's folder on this host (empty = no such part),
# the address the front door proxies yashGen to (the tunnel listens there), this host's own builder (a user unit, stopped
# while another computer runs it), the respeaker node's folder when it is not in the house. The house's ESP secrets it
# reads: ESPHOME_SECRETS (plug-in fwdesc).
YASHGEN_SRC=
YASHGEN_LISTEN=
YASHGEN_LOCAL_UNIT=
YASHGEN_RESPEAKER=
