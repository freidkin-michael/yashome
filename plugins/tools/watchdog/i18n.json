  "nothing to send again": "\u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0441\u043d\u043e\u0432\u0430 \u043d\u0435\u0447\u0435\u0433\u043e",
  "forgot {0}: gone for {1} days": "\u0437\u0430\u0431\u044b\u0442\u043e {0}: \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u043d\u0435\u0442 {1} \u0434\u043d.",
  "{0} gone devices still have data stored": "\u0417\u0430\u0431\u044b\u0442\u044b\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430: {0}",
  "; {0} of them are older than {1} days but their system is down": "; {0} \u0438\u0437 \u043d\u0438\u0445 \u0441\u0442\u0430\u0440\u0448\u0435 {1} \u0434\u043d., \u043d\u043e \u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442",
  "Settings, All devices, Forgotten: forget what is not coming back.": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438, \u0412\u0441\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430, \u0417\u0430\u0431\u044b\u0442\u044b\u0435: \u0437\u0430\u0431\u0443\u0434\u044c\u0442\u0435 \u0442\u043e, \u0447\u0442\u043e \u043d\u0435 \u0432\u0435\u0440\u043d\u0451\u0442\u0441\u044f.",
  "Forgotten devices": "\u0417\u0430\u0431\u044b\u0442\u044b\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430",
  "{0} open issues": "\u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c: {0}",
  "Note": "\u0417\u0430\u043c\u0435\u0442\u043a\u0430",
  "Open": "\u041e\u0442\u043a\u0440\u044b\u0442\u044c",
  "Forgetting": "\u0417\u0430\u0431\u044b\u0432\u0430\u043d\u0438\u0435",
  "Forget a gone device after, days": "\u0417\u0430\u0431\u044b\u0432\u0430\u0442\u044c \u043f\u0440\u043e\u043f\u0430\u0432\u0448\u0435\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0447\u0435\u0440\u0435\u0437, \u0434\u043d\u0435\u0439",
  "Its name, room and places go by themselves after this many days away, only while its system runs; 0: never, only by hand (All devices, Forgotten).": "\u0415\u0433\u043e \u0438\u043c\u044f, \u043a\u043e\u043c\u043d\u0430\u0442\u0430 \u0438 \u043c\u0435\u0441\u0442\u0430 \u0443\u0445\u043e\u0434\u044f\u0442 \u0441\u0430\u043c\u0438 \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f, \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043a\u0430 \u0435\u0433\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442; 0: \u043d\u0438\u043a\u043e\u0433\u0434\u0430, \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0440\u0443\u0447\u043d\u0443\u044e (\u0412\u0441\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430, \u0417\u0430\u0431\u044b\u0442\u044b\u0435).",
  "Saved": "\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043e",
  "A device that is gone loses its name, room and places by itself after this many days, only while its system runs. 0: never; Settings, All devices, Forgotten forgets by hand.": "\u041f\u0440\u043e\u043f\u0430\u0432\u0448\u0435\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0441\u0430\u043c\u043e \u0442\u0435\u0440\u044f\u0435\u0442 \u0438\u043c\u044f, \u043a\u043e\u043c\u043d\u0430\u0442\u0443 \u0438 \u043c\u0435\u0441\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439, \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043a\u0430 \u0435\u0433\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442. 0: \u043d\u0438\u043a\u043e\u0433\u0434\u0430; \u0432\u0440\u0443\u0447\u043d\u0443\u044e \u2014 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438, \u0412\u0441\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430, \u0417\u0430\u0431\u044b\u0442\u044b\u0435.",
  "Advanced": "\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e"
 }
