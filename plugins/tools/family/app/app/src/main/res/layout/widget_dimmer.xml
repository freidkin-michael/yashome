<?xml version="1.0" encoding="utf-8"?>
<!-- Dimmer tile: top third = brighter, middle = on/off (icon, caption, percent), bottom third = dimmer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg_off">
    <TextView android:id="@+id/w_up" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center" android:text="+" android:textColor="#FFFFFF"
        android:textSize="15sp" android:contentDescription="@string/device_widget_brighter" />
    <LinearLayout android:id="@+id/w_mid" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_icon" android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/wi_lamp_on" android:contentDescription="@string/device_widget_title" />
            <TextView android:id="@+id/w_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="3dp" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp"
            android:maxLines="1" android:ellipsize="end" android:paddingStart="4dp" android:paddingEnd="4dp" />
    </LinearLayout>
    <TextView android:id="@+id/w_down" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center" android:text="&#x2212;" android:textColor="#FFFFFF"
        android:textSize="15sp" android:contentDescription="@string/device_widget_dimmer" />
</LinearLayout>
