<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Yash" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand_bar</item>
        <item name="colorPrimaryDark">@color/brand_bar</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_bar</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
        <item name="android:textColorPrimary">@color/brand_text</item>
        <item name="android:textColorSecondary">@color/brand_muted</item>
        <item name="android:textColorHint">@color/brand_muted</item>
        <item name="colorButtonNormal">@color/brand_fill</item>
        <item name="buttonStyle">@style/Yash.Button</item>
        <!-- Nunito is not a system font: Roboto for text, Roboto Black for headings (closest to ExtraBold) -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="actionBarStyle">@style/Yash.ActionBar</item>
    </style>

    <style name="Theme.Yash.Transparent" parent="Theme.Yash">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="Yash.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/brand_bar</item>
        <item name="titleTextStyle">@style/Yash.ActionBarTitle</item>
    </style>
    <style name="Yash.ActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:fontFamily">sans-serif-black</item>
    </style>
    <style name="Yash.Heading" parent="">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <!-- Fill #177A75 with white text in both schemes: 5.2:1, AA (branding/README.md) -->
    <style name="Yash.Button" parent="Widget.AppCompat.Button">
        <item name="backgroundTint">@color/btn_fill</item>
        <item name="android:backgroundTint">@color/btn_fill</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
