<?xml version="1.0" encoding="utf-8"?>
<!-- The house token's encrypted file never leaves the phone: its key stays in this phone's Keystore -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
