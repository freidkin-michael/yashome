  "all control": "\u0432\u0441\u0451 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c",
  "hidden": "\u0441\u043a\u0440\u044b\u0442\u043e",
  "view": "\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c",
  "control": "\u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c",
  "Save": "\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c",
  "name, latin letters: phone1": "\u0438\u043c\u044f \u043b\u0430\u0442\u0438\u043d\u0438\u0446\u0435\u0439: phone1",
  "Someone at home": "\u0414\u043e\u043c\u0430 \u043a\u0442\u043e-\u0442\u043e \u0435\u0441\u0442\u044c",
  "home": "\u0434\u043e\u043c\u0430",
  "Connect to home": "\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043a \u0434\u043e\u043c\u0443",
  "This page is from the home dashboard. The link works for one hour.": "\u042d\u0442\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0441 \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u0433\u043e \u0434\u0430\u0448\u0431\u043e\u0440\u0434\u0430. \u0421\u0441\u044b\u043b\u043a\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0447\u0430\u0441.",
  "Open the Yash! app: the phone connects by itself.": "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 Yash!: \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0441\u044f \u0441\u0430\u043c.",
  "Open and connect": "\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u044c",
  "No app yet? Get it from the Family card on the dashboard.": "\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0435\u0449\u0451 \u043d\u0435\u0442? \u0421\u043a\u0430\u0447\u0430\u0439 \u0435\u0433\u043e \u043d\u0430 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0435 \u00ab\u0421\u0435\u043c\u044c\u044f\u00bb \u0432 \u0434\u0430\u0448\u0431\u043e\u0440\u0434\u0435.",
  "This link has no pairing data. Ask for a new QR on the dashboard.": "\u0412 \u0441\u0441\u044b\u043b\u043a\u0435 \u043d\u0435\u0442 \u0434\u0430\u043d\u043d\u044b\u0445 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f. \u041f\u043e\u043f\u0440\u043e\u0441\u0438 \u043d\u043e\u0432\u044b\u0439 QR \u043d\u0430 \u0434\u0430\u0448\u0431\u043e\u0440\u0434\u0435.",
  "connected": "\u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0451\u043d",
  "waiting": "\u0436\u0434\u0451\u0442 \u0441\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f",
  "qr expired": "QR \u0438\u0441\u0442\u0451\u043a",
  "New QR": "\u041d\u043e\u0432\u044b\u0439 QR",
  "For a name not in the list. Off: the phone sees nothing until you give it devices in Rights.": "\u0414\u043b\u044f \u0438\u043c\u0435\u043d\u0438, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0435\u0449\u0451 \u043d\u0435\u0442 \u0432 \u0441\u043f\u0438\u0441\u043a\u0435. \u0412\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e: \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0432\u0438\u0434\u0438\u0442, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0434\u0430\u0448\u044c \u0435\u043c\u0443 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0432 \u00ab\u041f\u0440\u0430\u0432\u0430\u0445\u00bb.",
  "A new QR for this phone? Its current link stops working at once; its rights stay.": "\u041d\u043e\u0432\u044b\u0439 QR \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430? \u0415\u0433\u043e \u0442\u0435\u043a\u0443\u0449\u0430\u044f \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0430 \u0441\u0440\u0430\u0437\u0443 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c; \u043f\u0440\u0430\u0432\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u0441\u044f.",
  "Family bridge": "\u0421\u0435\u043c\u0435\u0439\u043d\u044b\u0439 \u043c\u043e\u0441\u0442",
  "FAMILY_BRIDGE_KEY is not set": "FAMILY_BRIDGE_KEY \u043d\u0435 \u0437\u0430\u0434\u0430\u043d",
  "reachable now": "\u043d\u0430 \u0441\u0432\u044f\u0437\u0438",
  "not reachable now": "\u043d\u0435 \u043d\u0430 \u0441\u0432\u044f\u0437\u0438",
  "Stop": "\u0421\u0442\u043e\u043f",
  "Ring a phone": "\u041f\u043e\u0437\u0432\u043e\u043d\u0438\u0442\u044c \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d",
  "Phone": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d",
  "Seconds": "\u0421\u0435\u043a\u0443\u043d\u0434",
  "Pair a phone first": "\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438 \u0442\u0435\u043b\u0435\u0444\u043e\u043d",
  "ring": "\u0437\u0432\u043e\u043d\u043e\u043a",
  "dashboard only (no Firebase): {0} of {1} connected": "\u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0430\u0448\u0431\u043e\u0440\u0434 (\u0431\u0435\u0437 Firebase): \u043d\u0430 \u0441\u0432\u044f\u0437\u0438 {0} \u0438\u0437 {1}",
  "Do": "\u0427\u0442\u043e",
  "Stop ringing": "\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0437\u0432\u043e\u043d\u043e\u043a",
  "stop ringing": "\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0437\u0432\u043e\u043d\u043e\u043a",
  "A phone reaches the house only on its network or a VPN": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u0434\u043e\u0441\u0442\u0430\u0451\u0442 \u0434\u043e \u0434\u043e\u043c\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0435\u0433\u043e \u0441\u0435\u0442\u0438 \u0438\u043b\u0438 \u0447\u0435\u0440\u0435\u0437 VPN",
  "this QR is used or expired: make a new one in the dashboard": "\u044d\u0442\u043e\u0442 QR \u0443\u0436\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d \u0438\u043b\u0438 \u0443\u0441\u0442\u0430\u0440\u0435\u043b: \u0441\u0434\u0435\u043b\u0430\u0439 \u043d\u043e\u0432\u044b\u0439 \u0432 \u0434\u0430\u0448\u0431\u043e\u0440\u0434\u0435",
  "The app": "\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435",
  "Build the app": "\u0421\u043e\u0431\u0440\u0430\u0442\u044c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435",
  "not built yet": "\u0435\u0449\u0451 \u043d\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u043e",
  "building": "\u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f",
  "failed": "\u043e\u0448\u0438\u0431\u043a\u0430",
  "Widget states through Firebase": "\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0432\u0438\u0434\u0436\u0435\u0442\u043e\u0432 \u0447\u0435\u0440\u0435\u0437 Firebase",
  "A phone away from the house link gets its widgets' states as pushes - they pass Google's servers. Off: the widgets update when tapped and every 30 min.": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u0432\u043d\u0435 \u0441\u0432\u044f\u0437\u0438 \u0441 \u0434\u043e\u043c\u043e\u043c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0432\u0438\u0434\u0436\u0435\u0442\u043e\u0432 push-\u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f\u043c\u0438 - \u043e\u043d\u0438 \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0442 \u0447\u0435\u0440\u0435\u0437 \u0441\u0435\u0440\u0432\u0435\u0440\u044b Google. \u0412\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e: \u0432\u0438\u0434\u0436\u0435\u0442\u044b \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043f\u043e \u0442\u0430\u043f\u0443 \u0438 \u0440\u0430\u0437 \u0432 30 \u043c\u0438\u043d\u0443\u0442.",
  "only in Firebase: a leftover": "\u0442\u043e\u043b\u044c\u043a\u043e \u0432 Firebase: \u043e\u0441\u0442\u0430\u0442\u043e\u043a",
  "paired without its id: New QR (with an updated app) stops duplicates": "\u0441\u043f\u0430\u0440\u0435\u043d \u0431\u0435\u0437 id: \u043d\u043e\u0432\u044b\u0439 QR (\u0441 \u043e\u0431\u043d\u043e\u0432\u043b\u0451\u043d\u043d\u044b\u043c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c) \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0434\u0443\u0431\u043b\u0438",
  "Delete": "\u0423\u0434\u0430\u043b\u0438\u0442\u044c",
  "Delete this phone? Its token, its widgets and the rules that ring it go; it can be paired again.": "\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0442\u0435\u043b\u0435\u0444\u043e\u043d? \u0423\u0439\u0434\u0443\u0442 \u0435\u0433\u043e \u0442\u043e\u043a\u0435\u043d, \u0435\u0433\u043e \u0432\u0438\u0434\u0436\u0435\u0442\u044b \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0435\u043c\u0443 \u0437\u0432\u043e\u043d\u044f\u0442; \u0435\u0433\u043e \u043c\u043e\u0436\u043d\u043e \u0441\u043f\u0430\u0440\u0438\u0442\u044c \u0437\u0430\u043d\u043e\u0432\u043e.",
  "Family": "\u0421\u0435\u043c\u044c\u044f",
  "{0} of {1} at home": "\u0434\u043e\u043c\u0430 {0} \u0438\u0437 {1}",
  "another person's screen": "\u0427\u0443\u0436\u043e\u0439 \u044d\u043a\u0440\u0430\u043d",
  "bridge unreachable: {0}": "\u041c\u043e\u0441\u0442 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d: {0}",
  "bridge: {0}": "\u041c\u043e\u0441\u0442: {0}",
  "family_devices.json is unreadable: fix or remove it first": "family_devices.json \u043d\u0435 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f: \u0438\u0441\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u0438\u043b\u0438 \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u0435\u0433\u043e",
  "name: lowercase latin, 2-20 chars": "name: \u0441\u0442\u0440\u043e\u0447\u043d\u0430\u044f \u043b\u0430\u0442\u0438\u043d\u0438\u0446\u0430, 2\u201320 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432",
  "no app here yet: Family phone -> Build the app (or app/build.sh)": "\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043f\u043e\u043a\u0430 \u043d\u0435\u0442: \u0422\u0435\u043b\u0435\u0444\u043e\u043d \u0441\u0435\u043c\u044c\u0438 \u2192 \u0421\u043e\u0431\u0440\u0430\u0442\u044c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 (\u0438\u043b\u0438 app/build.sh)",
  "not a family phone": "\u042d\u0442\u043e \u043d\u0435 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0441\u0435\u043c\u044c\u0438",
  "only the dashboard does this": "\u042d\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0430\u043d\u0435\u043b\u044c \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f",
  "secs: a number": "secs: \u0447\u0438\u0441\u043b\u043e",
  "this phone is paired as {0} already: delete one of the two, then pair": "\u042d\u0442\u043e\u0442 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0443\u0436\u0435 \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d \u043a\u0430\u043a {0}: \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u043e\u0434\u043d\u0443 \u0438\u0437 \u0434\u0432\u0443\u0445 \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u0438 \u043f\u0440\u0438\u0432\u044f\u0436\u0438\u0442\u0435 \u0441\u043d\u043e\u0432\u0430",
  "unknown phone": "\u041d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d",
  "The family phones: who is at home, their rights, a new phone by QR. Its count is who is home of all.": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d\u044b \u0441\u0435\u043c\u044c\u0438: \u043a\u0442\u043e \u0434\u043e\u043c\u0430, \u0438\u0445 \u043f\u0440\u0430\u0432\u0430, \u043d\u043e\u0432\u044b\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u043f\u043e QR. \u0427\u0438\u0441\u043b\u043e \u043d\u0430 \u043a\u043d\u043e\u043f\u043a\u0435 - \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043e\u043c\u0430 \u0438\u0437 \u0432\u0441\u0435\u0445.",
  "Latin letters: the phone's name in the house; rules ring it by this name.": "\u041b\u0430\u0442\u0438\u043d\u0441\u043a\u0438\u0435 \u0431\u0443\u043a\u0432\u044b: \u0438\u043c\u044f \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u0432 \u0434\u043e\u043c\u0435; \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0437\u0432\u043e\u043d\u044f\u0442 \u043d\u0430 \u043d\u0435\u0433\u043e \u043f\u043e \u044d\u0442\u043e\u043c\u0443 \u0438\u043c\u0435\u043d\u0438.",
  "On: the new phone sees and switches everything. Off: it sees nothing until it gets devices in Rights.": "\u0412\u043a\u043b: \u043d\u043e\u0432\u044b\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0432\u0438\u0434\u0438\u0442 \u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0432\u0441\u0451. \u0412\u044b\u043a\u043b: \u043d\u0435 \u0432\u0438\u0434\u0438\u0442 \u043d\u0438\u0447\u0435\u0433\u043e, \u043f\u043e\u043a\u0430 \u0435\u043c\u0443 \u043d\u0435 \u0434\u0430\u0434\u0443\u0442 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0432 \u00ab\u041f\u0440\u0430\u0432\u0430\u0445\u00bb.",
  "A QR for the phone's camera: it opens the app and connects it; valid for one hour.": "QR \u0434\u043b\u044f \u043a\u0430\u043c\u0435\u0440\u044b \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430: \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0435\u0433\u043e; \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0447\u0430\u0441.",
  "Builds the Yash! app on the build server, signed with the house's key; a phone told of the update installs it.": "\u0421\u043e\u0431\u0438\u0440\u0430\u0435\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 Yash! \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435 \u0441\u0431\u043e\u0440\u043a\u0438, \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0435 \u043a\u043b\u044e\u0447\u043e\u043c \u0434\u043e\u043c\u0430; \u0442\u0435\u043b\u0435\u0444\u043e\u043d, \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0441\u043e\u043e\u0431\u0449\u0438\u043b\u0438 \u043e\u0431 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0438, \u0435\u0433\u043e \u0441\u0442\u0430\u0432\u0438\u0442.",
  "What this phone sees and may switch.": "\u0427\u0442\u043e \u044d\u0442\u043e\u0442 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0432\u0438\u0434\u0438\u0442 \u0438 \u043c\u043e\u0436\u0435\u0442 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u044c.",
  "Pairs this phone again: its current link stops at once; its rights stay.": "\u0421\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442 \u044d\u0442\u043e\u0442 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0437\u0430\u043d\u043e\u0432\u043e: \u0442\u0435\u043a\u0443\u0449\u0430\u044f \u0441\u0432\u044f\u0437\u044c \u0441\u0440\u0430\u0437\u0443 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c; \u043f\u0440\u0430\u0432\u0430 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f.",
  "Tells the phone to install the newer app.": "\u0412\u0435\u043b\u0438\u0442 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043d\u043e\u0432\u043e\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435.",
  "Rings the phone now, to find it.": "\u0417\u0432\u043e\u043d\u0438\u0442 \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0441\u0435\u0439\u0447\u0430\u0441, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438 \u0435\u0433\u043e.",
  "Stops its ringing.": "\u041e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0437\u0432\u043e\u043d\u043e\u043a.",
  "After a question its token, its widgets and the rules that ring it go; it can be paired again.": "\u041f\u043e\u0441\u043b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u0430 \u0443\u0445\u043e\u0434\u044f\u0442 \u0435\u0433\u043e \u0442\u043e\u043a\u0435\u043d, \u0432\u0438\u0434\u0436\u0435\u0442\u044b \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430 \u043d\u0435\u0433\u043e \u0437\u0432\u043e\u043d\u044f\u0442; \u0435\u0433\u043e \u043c\u043e\u0436\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u0442\u044c \u0441\u043d\u043e\u0432\u0430.",
  "Every device, seen and switched; the list below does not count then.": "\u0412\u0441\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0432\u0438\u0434\u043d\u044b \u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u0441\u044f; \u0441\u043f\u0438\u0441\u043e\u043a \u043d\u0438\u0436\u0435 \u0442\u043e\u0433\u0434\u0430 \u043d\u0435 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f.",
  "Sets every device below to hidden, view or control; Save keeps it.": "\u0421\u0442\u0430\u0432\u0438\u0442 \u0432\u0441\u0435\u043c \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c \u043d\u0438\u0436\u0435 \u00ab\u0441\u043a\u0440\u044b\u0442\u043e\u00bb, \u00ab\u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u00bb \u0438\u043b\u0438 \u00ab\u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u00bb; \u00ab\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c\u00bb \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442.",
  "Hidden: it never reaches the phone. View: seen, not switched. Control: seen and switched.": "\u0421\u043a\u0440\u044b\u0442\u043e: \u0434\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u043d\u0435 \u0434\u043e\u0445\u043e\u0434\u0438\u0442. \u041f\u0440\u043e\u0441\u043c\u043e\u0442\u0440: \u0432\u0438\u0434\u043d\u043e, \u043d\u0435 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f. \u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435: \u0432\u0438\u0434\u043d\u043e \u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f.",
  "Saves the rights; the server checks them on every command of the phone.": "\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u043f\u0440\u0430\u0432\u0430; \u0441\u0435\u0440\u0432\u0435\u0440 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442 \u0438\u0445 \u043f\u0440\u0438 \u043a\u0430\u0436\u0434\u043e\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u0435 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430.",
  "The family phone the rule rings.": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u0441\u0435\u043c\u044c\u0438, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0432\u043e\u043d\u0438\u0442 \u043f\u0440\u0430\u0432\u0438\u043b\u043e.",
  "Ring, or stop its ringing.": "\u041f\u043e\u0437\u0432\u043e\u043d\u0438\u0442\u044c \u0438\u043b\u0438 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0437\u0432\u043e\u043d\u043e\u043a.",
  "How long it rings: 5 to 300 seconds.": "\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0432\u043e\u043d\u0438\u0442: \u043e\u0442 5 \u0434\u043e 300 \u0441\u0435\u043a\u0443\u043d\u0434.",
  "All at once": "\u0412\u0441\u0435 \u0441\u0440\u0430\u0437\u0443",
  "Per device": "\u041f\u043e \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c",
  "Rule builder": "\u041a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440 \u043f\u0440\u0430\u0432\u0438\u043b",
  "Name": "\u0418\u043c\u044f",
  "An update generates it": "\u0415\u0433\u043e \u0441\u043e\u0437\u0434\u0430\u0451\u0442 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435",
  "Is the family-bridge container running?": "\u0417\u0430\u043f\u0443\u0449\u0435\u043d \u043b\u0438 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440 family-bridge?",
  "App": "\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435",
  "At home now: {0}. Away: {1}.": "\u0421\u0435\u0439\u0447\u0430\u0441 \u0434\u043e\u043c\u0430: {0}. \u041d\u0435 \u0434\u043e\u043c\u0430: {1}.",
  "nobody": "\u043d\u0438\u043a\u043e\u0433\u043e",
  "No one in the family yet.": "\u0412 \u0441\u0435\u043c\u044c\u0435 \u043f\u043e\u043a\u0430 \u043d\u0438\u043a\u043e\u0433\u043e.",
  "Add a family member": "\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0447\u043b\u0435\u043d\u0430 \u0441\u0435\u043c\u044c\u0438",
  "Name, in any language": "\u0418\u043c\u044f, \u043d\u0430 \u043b\u044e\u0431\u043e\u043c \u044f\u0437\u044b\u043a\u0435",
  "Off: the phone sees nothing until you give it devices in Rights.": "\u0412\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e: \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0432\u0438\u0434\u0438\u0442, \u043f\u043e\u043a\u0430 \u0432\u044b \u043d\u0435 \u0434\u0430\u0434\u0438\u0442\u0435 \u0435\u043c\u0443 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0432 \u00ab\u041f\u0440\u0430\u0432\u0430\u0445\u00bb.",
  "The QR is scanned with the new phone's camera: it opens the Yash! app and connects it.": "QR \u0441\u043a\u0430\u043d\u0438\u0440\u0443\u044e\u0442 \u043a\u0430\u043c\u0435\u0440\u043e\u0439 \u043d\u043e\u0432\u043e\u0433\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430: \u043e\u043d \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 Yash! \u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0435\u0433\u043e.",
  "Name:": "\u0418\u043c\u044f:",
  "Rename": "\u041f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u0442\u044c",
  "Remove": "\u0423\u0431\u0440\u0430\u0442\u044c",
  "Ring\u2026": "\u041f\u043e\u0437\u0432\u043e\u043d\u0438\u0442\u044c\u2026",
  "seen {0}": "\u0431\u044b\u043b \u0432\u0438\u0434\u0435\u043d {0}",
  "Remove {0} from the family? The phone's token, its widgets and the rules that ring it go; it can be added again.": "\u0423\u0431\u0440\u0430\u0442\u044c {0} \u0438\u0437 \u0441\u0435\u043c\u044c\u0438? \u0422\u043e\u043a\u0435\u043d \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430, \u0435\u0433\u043e \u0432\u0438\u0434\u0436\u0435\u0442\u044b \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0435\u043c\u0443 \u0437\u0432\u043e\u043d\u044f\u0442, \u0443\u0439\u0434\u0443\u0442; \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043c\u043e\u0436\u043d\u043e \u0441\u043d\u043e\u0432\u0430.",
  "The Yash! app for the family phones; a phone told of a newer one updates itself.": "\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 Yash! \u0434\u043b\u044f \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u0432 \u0441\u0435\u043c\u044c\u0438; \u0442\u0435\u043b\u0435\u0444\u043e\u043d, \u0443\u0437\u043d\u0430\u0432 \u043e \u043d\u043e\u0432\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438, \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u0430\u043c.",
  "The member's name in any language: the header, voice answers and rules show it.": "\u0418\u043c\u044f \u0447\u043b\u0435\u043d\u0430 \u0441\u0435\u043c\u044c\u0438 \u043d\u0430 \u043b\u044e\u0431\u043e\u043c \u044f\u0437\u044b\u043a\u0435: \u0435\u0433\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0448\u0430\u043f\u043a\u0430, \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u044b\u0435 \u043e\u0442\u0432\u0435\u0442\u044b \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430.",
  "Changes the name people see; the phone stays connected.": "\u041c\u0435\u043d\u044f\u0435\u0442 \u0438\u043c\u044f, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u0438\u0434\u044f\u0442 \u043b\u044e\u0434\u0438; \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u044b\u043c.",
  "What this member's phone sees and may switch.": "\u0427\u0442\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u044d\u0442\u043e\u0433\u043e \u0447\u043b\u0435\u043d\u0430 \u0441\u0435\u043c\u044c\u0438 \u0432\u0438\u0434\u0438\u0442 \u0438 \u043c\u043e\u0436\u0435\u0442 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u044c.",
  "Pairs the phone again: its current link stops at once; its rights stay.": "\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0437\u0430\u043d\u043e\u0432\u043e: \u0442\u0435\u043a\u0443\u0449\u0430\u044f \u0441\u0441\u044b\u043b\u043a\u0430 \u0441\u0440\u0430\u0437\u0443 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c; \u043f\u0440\u0430\u0432\u0430 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f.",
  "Ring the phone to find it, stop it, or tell it to update the app.": "\u041f\u043e\u0437\u0432\u043e\u043d\u0438\u0442\u044c \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438 \u0435\u0433\u043e, \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0437\u0432\u043e\u043d\u043e\u043a \u0438\u043b\u0438 \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u0442\u044c \u043e\u0431\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435.",
  "After a question the phone's token, its widgets and the rules that ring it go; it can be added again.": "\u041f\u043e\u0441\u043b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u0430 \u0442\u043e\u043a\u0435\u043d \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430, \u0435\u0433\u043e \u0432\u0438\u0434\u0436\u0435\u0442\u044b \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0435\u043c\u0443 \u0437\u0432\u043e\u043d\u044f\u0442, \u0443\u0445\u043e\u0434\u044f\u0442; \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043c\u043e\u0436\u043d\u043e \u0441\u043d\u043e\u0432\u0430.",
  "no such family member": "\u0442\u0430\u043a\u043e\u0433\u043e \u0447\u043b\u0435\u043d\u0430 \u0441\u0435\u043c\u044c\u0438 \u043d\u0435\u0442",
  "the build plug-in is off: PLUGINS in .env needs build (and a computer with the Android app builder)": "\u043f\u043b\u0430\u0433\u0438\u043d \u0441\u0431\u043e\u0440\u043a\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d: \u0432 PLUGINS \u0432 .env \u043d\u0443\u0436\u0435\u043d build (\u0438 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440 \u0441\u043e \u0441\u0431\u043e\u0440\u0449\u0438\u043a\u043e\u043c Android-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439)",
  "no app here yet": "\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0435\u0449\u0451 \u043d\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u043e",
  "Also at home when": "\u0415\u0449\u0451 \u0434\u043e\u043c\u0430, \u0435\u0441\u043b\u0438",
  "its Wi-Fi presence device says so (a phone of the cloud has no live link)": "\u0442\u0430\u043a \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0435\u0433\u043e \u0434\u0430\u0442\u0447\u0438\u043a \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f \u043f\u043e Wi-Fi (\u0443 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u0447\u0435\u0440\u0435\u0437 \u043e\u0431\u043b\u0430\u043a\u043e \u043d\u0435\u0442 \u0436\u0438\u0432\u043e\u0439 \u0441\u0432\u044f\u0437\u0438)",
  "no device": "\u043d\u0435\u0442 \u0434\u0430\u0442\u0447\u0438\u043a\u0430",
  "Address for the phones": "\u0410\u0434\u0440\u0435\u0441 \u0434\u043b\u044f \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u0432",
  "It goes into every pairing QR. Empty: this house on its network ({0}); a name over https reaches the phones away from home too.": "\u041e\u043d \u043f\u043e\u043f\u0430\u0434\u0430\u0435\u0442 \u0432 \u043a\u0430\u0436\u0434\u044b\u0439 QR \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0438. \u041f\u0443\u0441\u0442\u043e \u2014 \u0430\u0434\u0440\u0435\u0441 \u0434\u043e\u043c\u0430 \u0432 \u0435\u0433\u043e \u0441\u0435\u0442\u0438 ({0}); \u0438\u043c\u044f \u043f\u043e https \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0438 \u0432\u043d\u0435 \u0434\u043e\u043c\u0430.",
  "Away from home the phones cannot reach this address.": "\u0412\u043d\u0435 \u0434\u043e\u043c\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u044b \u0434\u043e \u044d\u0442\u043e\u0433\u043e \u0430\u0434\u0440\u0435\u0441\u0430 \u043d\u0435 \u0434\u043e\u0441\u0442\u0430\u043d\u0443\u0442.",
  "Saved": "\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043e",
  "no address for the phones: BIND_ADDRESS, or Settings -> Family -> App": "\u043d\u0435\u0442 \u0430\u0434\u0440\u0435\u0441\u0430 \u0434\u043b\u044f \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u0432: BIND_ADDRESS \u0438\u043b\u0438 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u2192 \u0421\u0435\u043c\u044c\u044f \u2192 \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435",
  "not a presence device": "\u044d\u0442\u043e \u043d\u0435 \u0434\u0430\u0442\u0447\u0438\u043a \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f",
  "the address: http(s)://host[:port]": "\u0430\u0434\u0440\u0435\u0441: http(s)://\u0445\u043e\u0441\u0442[:\u043f\u043e\u0440\u0442]",
  "Empty: this house on its own network. A name over https (behind a proxy) lets the phones reach it away from home too.": "\u041f\u0443\u0441\u0442\u043e \u2014 \u0434\u043e\u043c \u0432 \u0441\u0432\u043e\u0435\u0439 \u0441\u0435\u0442\u0438. \u0418\u043c\u044f \u043f\u043e https (\u0447\u0435\u0440\u0435\u0437 \u043f\u0440\u043e\u043a\u0441\u0438) \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430\u043c \u0434\u043e\u0441\u0442\u0430\u0442\u044c \u0434\u043e \u043d\u0435\u0433\u043e \u0438 \u0432\u043d\u0435 \u0434\u043e\u043c\u0430.",
  "The next pairing QR holds the new address; phones paired before keep theirs until a New QR.": "\u041d\u043e\u0432\u044b\u0439 \u0430\u0434\u0440\u0435\u0441 \u043f\u043e\u043f\u0430\u0434\u0451\u0442 \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 QR \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0438; \u0443\u0436\u0435 \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442 \u043f\u0440\u0435\u0436\u043d\u0438\u0439 \u0434\u043e \u043d\u043e\u0432\u043e\u0433\u043e QR.",
  "too many notes: try later": "\u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u043d\u043e\u0433\u043e \u0437\u0430\u043c\u0435\u0442\u043e\u043a: \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043f\u043e\u0437\u0436\u0435"
 }
}
