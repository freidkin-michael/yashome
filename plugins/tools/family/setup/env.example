# Your Firebase project (optional): its Realtime Database URL, a service account key (JSON file on this host), and
# the Android package the app is built as (the app registered in that project; empty = com.yash.home).
FAMILY_FIREBASE_DB=
# [host-only] the key file's path on this host
FAMILY_FIREBASE_KEY=
FAMILY_APP_ID=
# The family bridge (Firebase side, the container family-bridge) and its broker account: made by make install.
FAMILY_BRIDGE_KEY=
MQTT_FAMILY_USER=family
MQTT_FAMILY_PASSWORD=
