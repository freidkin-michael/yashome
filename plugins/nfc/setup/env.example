# NTAG 424 DNA SDM keys (32 hex chars each). Keep them secret.
NFC_SDM_META_KEY=
NFC_SDM_FILE_KEY=
# The cards: <uid hex>=<name>, comma separated; a tap of one is the event "card = <name>" of the
# device NFC_DEVICE (default nfc) - a rule decides what it does. Needs EXTRA_PIP=cryptography==50.0.1
NFC_CARDS=
NFC_DEVICE=
